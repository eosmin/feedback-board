{
  "name": "@feedback-board/api",
  "author": "Erick Monjaras <osminerick@gmail.com>",
  "version": "0.0.0",
  "private": true,
  "description": "FeedbackBoard HTTP API — controllers, guards, Stripe and the queue producer half",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --testPathPatterns test/unit",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --testPathPatterns test/unit --coverage",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --testPathPatterns test/e2e --runInBand --forceExit"
  },
  "dependencies": {
    "@bull-board/api": "9.8.0",
    "@bull-board/express": "9.8.0",
    "@bull-board/nestjs": "9.8.0",
    "@feedback-board/core": "workspace:*",
    "@feedback-board/shared": "workspace:*",
    "@nestjs/bull-shared": "12.0.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "bullmq": "6.3.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.1.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "22.6.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@supabase/supabase-js": "2.115.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.x",
    "@types/node": "24.x",
    "@types/supertest": "6.x",
    "jest": "30.5.1",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3"
  }
}
