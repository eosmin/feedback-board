{
  "name": "@feedback-board/worker",
  "author": "Erick Monjaras <osminerick@gmail.com>",
  "version": "0.0.0",
  "private": true,
  "description": "FeedbackBoard queue consumer — no HTTP adapter, processes the webhooks and ai-classify queues (TDD §2.2b, §3.10)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --coverage"
  },
  "dependencies": {
    "@feedback-board/core": "workspace:*",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "bullmq": "6.3.4",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/jest": "30.x",
    "@types/node": "24.x",
    "jest": "30.5.1",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3"
  }
}
