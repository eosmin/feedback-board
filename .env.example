# Supabase (auth only — the API never calls Supabase's REST/Auth API)
# SUPABASE_URL is used by the API for one thing: deriving the JWKS URL and the JWT issuer.
# The project MUST use asymmetric JWT signing keys or there is no JWKS to fetch.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NOTE: there is deliberately no SUPABASE_SERVICE_ROLE_KEY and no bare SUPABASE_ANON_KEY.
# Nothing in this project consumes them; an unused secret is still a secret to leak.
# The e2e suite obtains real tokens through the local mail catcher instead of an admin key.

# Test-only. Read by apps/api/test/fixtures/sign-in.ts to pull the magic-link OTP out of the
# local stack's mailbox. Belongs to NO runtime env schema — if a service reads this, that is a bug.
# The port is whatever `supabase start` printed; do not assume 54324.
SUPABASE_INBUCKET_URL=http://127.0.0.1:54324

# Database — three roles, three jobs (§2.6.11). Do not collapse these into one.
DATABASE_URL=                     # pooled, role feedbackboard_app  — running app, RLS ENFORCED.
                                  #   Created by scripts/bootstrap-db.sh (Step 11) — run it, and
                                  #   run the RLS migration, BEFORE pointing this var at the role.
DIRECT_URL=                       # direct, owner role              — prisma migrate only
ADMIN_DATABASE_URL=               # direct, owner role              — PrismaService: stripe webhook,
                                  #   auth mirror, Oership lookup, org collection
                                  #   routes, public board resolver. RLS bypassed via BYPASSRLS
                                  #   (§2.6.11c) — required, because FORCE ROW LEVEL SECURITY
                                  #   removes the table-owner exemption this role would
                                  #   otherwise have relied on.
                                  #   apps/api ONLY. The worker has no admin caller, so its
                                  #   schema must REJECT this var, not merely ignore it.
APP_DB_PASSWORD=                  # consumed ONLY by scripts/bootstrap-db.sh to create/rotate
                                  #   the feedbackboard_app role. Must match the password
                                  #   embedded in DATABASE_URL. Never in a migration.

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=            # from `stripe listen` locally; a DIFFERENT value in prod
STRIPE_PRO_PRICE_ID=

# AI — Vercel AI Gateway. ONE credential for every provider.
AI_GATEWAY_API_KEY=
AI_CLASSIFY_MODEL=anthropic/claude-haiku-4.5
AI_DIGEST_MODEL=anthropic/claude-sonnet-4.5
# Optional: fully custom / self-hosted endpoint. If set, overrides the Gateway for both AI
# features; AI_CLASSIFY_MODEL/AI_DIGEST_MODEL become bare model ids for that endpoint.
# AI_CUSTOM_BASE_URL=
# AI_CUSTOM_API_KEY=
# AI_CUSTOM_PROVIDER_NAME=
# AI_CUSTOM_SUPPORTS_STRUCTURED_OUTPUTS=true

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
# Bull Board — operator UI, OFF by default.
BULL_BOARD_ENABLED=false
BULL_BOARD_ADMIN_EMAILS=          # comma-separated allowlist; empty = nobody

# App
NODE_ENV=development
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000